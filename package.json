{
  "name": "chrome",
  "version": "0.2.5",
  "private": true,
  "description": "DSH plugin: drive background tabs in the current Chrome, and send a picked element into the composer.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:pure": "node test/run-pure.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "file:vendor/browser-execution/deepseek-ai-cordis-4.0.5-alpha.1.tgz",
    "@deepseek-ai/cosmokit": "file:vendor/browser-execution/deepseek-ai-cosmokit-1.8.6-alpha.1.tgz",
    "@deepseek-ai/dsh-brand": "file:vendor/browser-execution/deepseek-ai-dsh-brand-0.2.1-alpha.2.tgz",
    "@deepseek-ai/dsh-browser-use": "file:vendor/browser-execution/deepseek-ai-dsh-browser-use-0.2.1-alpha.4.browser-policy.1.tgz",
    "@standard-schema/spec": "file:vendor/browser-execution/standard-schema-spec-1.1.0.tgz",
    "jpeg-js": "0.4.4"
  }
}
