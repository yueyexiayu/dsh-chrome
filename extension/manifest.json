{
  "manifest_version": 3,
  "name": "DSH Chrome",
  "version": "0.1.0",
  "description": "Lets DeepSeek Harness drive background tabs in this Chrome without stealing focus.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "tabGroups", "nativeMessaging", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
